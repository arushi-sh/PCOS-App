# Copy this file to backend/.env and fill in your own values.
# backend/.env is git-ignored.

DB_USER=postgres
DB_PASS=your_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pcos_db

# Origin allowed by CORS (the Next.js frontend)
FRONTEND_URL=http://localhost:3000

# Optional: defaults to http://ml-service:8005 (Docker network)
# ML_SERVICE_URL=http://localhost:8005

# Optional: full connection string, overrides the DB_* values above
# DATABASE_URL=postgres://user:pass@host:5432/pcos_db?sslmode=disable
